# ─── MongoDB Atlas ───────────────────────────────────────────────────────────
# Get your connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/avensa?retryWrites=true&w=majority

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-very-long-random-secret-here-minimum-32-characters
JWT_EXPIRES_IN=7d

# ─── Next.js ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=development
